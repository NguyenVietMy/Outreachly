# Copy to agent/.env (gitignored) and fill in. Values match api/.env.local.properties.

# Shared secret with the Java API, both directions. Required — the service will not boot without it.
INTERNAL_TOKEN=dev

# Qdrant Cloud (issue 01). The REST URL, as handed out by Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# Generation.
ANTHROPIC_API_KEY=

# Embeddings only (text-embedding-3-small) — Anthropic has no embeddings API.
OPENAI_API_KEY=

# Java internal context API (issue 06). Overridden to http://api:8080 by docker-compose.
PULSE_API_URL=http://localhost:8080

# Wired in issue 10.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
